{
  "name": "result-poller",
  "description": "Polls HiddenLayer scan results and updates artifact properties",
  "version": "1.0.0",
  "scripts": {
    "deploy": "jf worker deploy",
    "undeploy": "jf worker rm \"result-poller\"",
    "test": "jest"
  },
  "license": "ISC",
  "jest": {
    "moduleFileExtensions": [
      "ts",
      "js"
    ],
    "rootDir": ".",
    "testEnvironment": "node",
    "clearMocks": true,
    "maxConcurrency": 1,
    "testRegex": "\\.spec\\.ts$",
    "moduleDirectories": [
      "node_modules"
    ],
    "collectCoverageFrom": [
      "**/*.ts"
    ],
    "coverageDirectory": "../coverage",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "testRunner": "jest-jasmine2",
    "verbose": true
  }
}
